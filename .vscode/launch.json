{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Home Assistant",
      "type": "debugpy",
      "request": "launch",
      "module": "homeassistant",
      "args": ["--config", "/config"],
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/custom_components/glitrenett",
          "remoteRoot": "/config/custom_components/glitrenett"
        }
      ],
      "python": "${command:python.interpreterPath}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
